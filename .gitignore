# Compiled binaries
/easydnd
/devslot
/llm
/bin/

# Frontend release tarball (`make web/release`). The bundle's own build output
# and node_modules are ignored by web/.gitignore.
/web.tar.gz

# Test and coverage output
*.test
coverage.out
coverage.html

# Local environment overrides
# Nothing reads these -- secrets live in ~/config/easydnd/dev.env, outside every
# worktree -- but they stay ignored so a stray one can never be committed.
.env
.env.local

# No longer read or written: these three used to hold a worktree's ports and
# its LLM key. Still ignored, so one left over from before cannot be committed
# with the key inside it.
config.local.yaml
config.dev-run.yaml
config.preview.yaml

# Written by `make dev`: this worktree's port slot. Per-worktree by design --
# it is the whole mechanism that stops two worktrees claiming the same ports.
.dev-slot

# Optional Make overrides for this machine or this worktree (PUBLIC_HOST,
# SLOT). The machine-wide one lives at ~/.config/easydnd/dev.mk.
local.mk

# Editor / OS noise
.idea/
.vscode/
.DS_Store

# Optional local immutable pack archive
.pack-archive/
