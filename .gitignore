# Compiled binaries
/easydnd
/srdgen
/devslot
/bin/

# Frontend release tarball (`make web/release`). The bundle's own build output
# and node_modules are ignored by web/.gitignore.
/web.tar.gz

# Test and coverage output
*.test
coverage.out
coverage.html

# Local environment overrides
# Nothing reads these -- configuration lives in a YAML file now -- but they stay
# ignored so a stray one can never be committed.
.env
.env.local

# Local config override: copy config.dev.yaml and point -config at it.
config.local.yaml

# Written by `make dev`: this worktree's port slot. Per-worktree by design --
# it is the whole mechanism that stops two worktrees claiming the same ports.
.dev-slot

# Written by `make config/dev`: a whole development config for this worktree's
# slot. Generated, never edited by hand.
config.dev-run.yaml

# Optional Make overrides for this machine or this worktree (PUBLIC_HOST,
# SLOT). The machine-wide one lives at ~/.config/easydnd/dev.mk.
local.mk

# Editor / OS noise
.idea/
.vscode/
.DS_Store

# Written by `make config/preview`; see the preview target.
config.preview.yaml
