# The template for both env files. Nothing here is read by the app from disk:
# whatever starts the process loads the file into its environment, and
# internal/config lays those variables over the committed YAML.
#
#   development   ~/config/easydnd/dev.env    one file for every worktree,
#                                             mode 600, loaded by make
#   production    /etc/easydnd/prod.env       640 root:easydnd, loaded by
#                                             supervisor; never part of a deploy
#
# Shell syntax, sourced with `set -a`: NAME=value, quote anything with a space.
# An unset or empty variable leaves the config file's value alone.

# The LLM key behind the AI Wizard. Without it the feature is off.
EASYDND_AGENT_API_KEY=

# --- production only -------------------------------------------------------

# REQUIRED. `openssl rand -base64 48`. Rotating it signs everyone out, and
# costs nobody a passkey.
EASYDND_SESSION_SECRET="REPLACE-ME-WITH-openssl-rand-base64-48"

# REQUIRED. Keep sslmode=verify-full: the RDS certificate bundle is compiled
# into the binary, and an omitted sslmode allows a plaintext fallback.
EASYDND_DB_URL="postgres://easydnd:REPLACE-ME-WITH-THE-RDS-PASSWORD@REPLACE-ME.eu-central-1.rds.amazonaws.com:5432/easydnd?sslmode=verify-full"

# --- optional, either environment ------------------------------------------

# PostHog browser project token (phc_), entered locally; never commit the value.
# The ingestion host stays in analytics.host in the YAML. Unset means analytics
# is off with the committed configs. Do not use a personal or secret API key.
EASYDND_POSTHOG_TOKEN=

# Sign in with Google: both or neither. An OAuth 2.0 Client ID of type "Web
# application"; register <origin>/v1/auth/sso/google/callback for every origin
# it will be used from -- `make ports` prints a worktree's.
# EASYDND_GOOGLE_CLIENT_ID=REPLACE-ME.apps.googleusercontent.com
# EASYDND_GOOGLE_CLIENT_SECRET="REPLACE-ME-WITH-THE-GOOGLE-CLIENT-SECRET"

# Private rule packs: directories on this host, comma-separated. Installed but
# listed only for auth.superadmins and the groups one of them grants a pack to.
# In production add this AFTER deploy/push-private-pack.sh has put the pack
# there -- a path that does not exist is a startup error.
# EASYDND_PRIVATE_PACK_FILES=/opt/easydnd/private-packs/easydnd-2014-personal

# --- set by make, not here --------------------------------------------------

# A development API's port and passkey origins come from the worktree's slot:
# `make run/server` and `make run/db` pass these three over whatever this file
# says, so a value here does nothing in development. They are listed because
# the loader reads them; production takes all three from config.prod.yaml.
# EASYDND_HTTP_PORT=
# EASYDND_RP_ID=
# EASYDND_RP_ORIGINS=
