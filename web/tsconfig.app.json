{
  "compilerOptions": {
    /* tsBuildInfoFile alone writes a stub that carries no file signatures, so
       `tsc -b` re-checked everything every run. */
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness. exactOptionalPropertyTypes is on because the API envelope
       has genuinely optional fields (fields, request_id) and conflating
       "absent" with "explicitly undefined" is how those bugs start. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* No baseUrl: it is deprecated in TS 6, and paths resolve relative to this
       file without it. */
    "paths": {
      "@/*": ["./src/*"],
      "@locales/*": ["./locales/*"]
    }
  },
  "include": ["src", "locales"]
}
